<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21/owo-ui.xsd">
    <!--
      Skyz Cosmetics — owo-lib edition.

      Cosmetics functionality is provided by Essential mod's Wardrobe.
      Same pattern as SkyzFriendsScreen: detect Essential, surface a
      Skyz-styled card with either an "OPEN ESSENTIAL WARDROBE" launcher
      button (and inline error reporting when reflection fails) or an
      install prompt with a copy-link button if Essential isn't loaded.
    -->
    <components>
        <flow-layout direction="vertical">
            <sizing>
                <horizontal method="fill">100</horizontal>
                <vertical method="fill">100</vertical>
            </sizing>
            <padding>
                <top>14</top>
                <bottom>16</bottom>
                <left>20</left>
                <right>20</right>
            </padding>
            <gap>10</gap>

            <children>
                <!-- ── Nav bar ─────────────────────────────────────────── -->
                <flow-layout direction="horizontal">
                    <sizing>
                        <horizontal method="fill">100</horizontal>
                        <vertical method="content"/>
                    </sizing>
                    <gap>6</gap>
                    <vertical-alignment>center</vertical-alignment>
                    <children>
                        <label>
                            <text>SKYZ</text>
                            <color>#FFEEF6FF</color>
                        </label>
                        <label>
                            <text>/</text>
                            <color>#4D8CD2FF</color>
                        </label>
                        <label>
                            <text>COSMETICS</text>
                            <color>#888CD2FF</color>
                        </label>
                        <flow-layout direction="horizontal">
                            <sizing>
                                <horizontal method="expand">100</horizontal>
                                <vertical method="content"/>
                            </sizing>
                        </flow-layout>
                        <button id="btn-back">
                            <text>← BACK</text>
                            <sizing>
                                <horizontal method="fixed">76</horizontal>
                                <vertical method="fixed">20</vertical>
                            </sizing>
                        </button>
                    </children>
                </flow-layout>

                <flow-layout direction="horizontal">
                    <sizing>
                        <horizontal method="fill">100</horizontal>
                        <vertical method="expand">100</vertical>
                    </sizing>
                    <horizontal-alignment>center</horizontal-alignment>
                    <vertical-alignment>center</vertical-alignment>
                    <children>
                        <flow-layout id="content-card" direction="vertical">
                            <sizing>
                                <horizontal method="fixed">360</horizontal>
                                <vertical method="content"/>
                            </sizing>
                            <padding>
                                <top>18</top>
                                <bottom>18</bottom>
                                <left>20</left>
                                <right>20</right>
                            </padding>
                            <gap>8</gap>
                            <horizontal-alignment>center</horizontal-alignment>
                        </flow-layout>
                    </children>
                </flow-layout>
            </children>
        </flow-layout>
    </components>
</owo-ui>
